logline "03.03 update system - this can take a while.."
# Use full-upgrade (== dist-upgrade) instead of upgrade so we don't silently
# hold back package transitions (kernel ABI bumps, library SO-name changes,
# package renames). DEBIAN_FRONTEND / NEEDRESTART_MODE are exported in
# parts/00_settings; APT_CONF_OPTS keeps config-file conflicts non-interactive
# by defaulting to the existing local copy.
apt update
apt full-upgrade -y "${APT_CONF_OPTS[@]}"
# Drop packages no longer needed by anything (e.g. old kernel images) and
# free the apt cache.
apt autoremove -y --purge
apt clean

logline "03.04 apt some sysop and dev tools"
apt install -qq -y htop iotop ncdu pv unzip build-essential autoconf automake git 

logline "03.05 apt some extra tools"
# ufw is firewall
apt install -qq -y ufw

# this is for hypervisor so VM manager knows us
apt install -qq -y acpid  cloud-init

systemctl enable acpid
systemctl start acpid

logline "03.05 apt Sury repo"
# Install dependencies
apt install -y apt-transport-https lsb-release ca-certificates curl
# Add Sury GPG key
curl -sSLo /usr/share/keyrings/deb.sury.org-php.gpg https://packages.sury.org/php/apt.gpg
# Add repository
echo "deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" > /etc/apt/sources.list.d/php.list
# Update
apt update

logline "03.06 GitHub CLI (gh) - official cli.github.com repo"
# Use the official upstream repo per
#   https://github.com/cli/cli/blob/trunk/docs/install_linux.md
# We avoid Debian's community 'gh' package - upstream notes (Nov 2025) that
# the community 2.45.x / 2.46.x is broken against current GitHub APIs.
mkdir -p -m 755 /etc/apt/keyrings
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
	| tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
	> /etc/apt/sources.list.d/github-cli.list
apt update
apt install -y gh   # DEBIAN_FRONTEND inherited from parts/00_settings
echo "Installed: $(gh --version | head -n1)"

logline "03.07 GitLab CLI (glab) - latest .deb from gitlab.com upstream"
# We fetch the upstream Debian package because:
#  - Debian 12 (Bookworm) does NOT ship glab at all
#  - Debian 13 (Trixie) only ships v1.53 (often months behind)
# Upstream now publishes proper .deb files per release; `apt install ./X.deb`
# resolves any deps automatically and integrates with dpkg/apt for upgrades.
apt install -y jq

# Map Debian arch names to the labels glab uses in its release asset names.
#   Debian   -> glab asset
#   amd64    -> amd64       (same)
#   arm64    -> arm64       (same)
#   s390x    -> s390x       (same)
#   i386     -> 386
#   armhf    -> armv6
#   ppc64el  -> ppc64le
glab_arch=$(dpkg --print-architecture)
case "$glab_arch" in
	i386)    glab_asset_arch=386     ;;
	armhf)   glab_asset_arch=armv6   ;;
	ppc64el) glab_asset_arch=ppc64le ;;
	*)       glab_asset_arch="$glab_arch" ;;
esac

# Each asset link has a plain `.name` (e.g. glab_1.100.0_linux_amd64.deb) and
# a percent-encoded `.url`. Filter on `.name` to keep the jq query simple and
# use `.direct_asset_url` (the human-readable URL) for the download.
glab_url=$(curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest" \
	| jq -r --arg name "_linux_${glab_asset_arch}.deb" \
		'.assets.links[] | select(.name | endswith($name)) | .direct_asset_url' \
	| head -n1)
if [ -n "$glab_url" ]; then
	glab_tmp=$(mktemp --suffix=.deb)
	curl -fsSL "$glab_url" -o "$glab_tmp"
	# apt install (not dpkg -i) so any deps get pulled in automatically.
	# DEBIAN_FRONTEND inherited from parts/00_settings
	apt install -y "$glab_tmp"
	rm -f "$glab_tmp"
	echo "Installed: $(glab --version | head -n1)"
else
	echo "!! could not find a glab .deb for arch=$glab_arch (asset arch=$glab_asset_arch) - skipping"
fi

# Authentication note (informational, not done here because it is per-user):
#   gh auth login            # stores token in ~/.config/gh/
#   glab auth login          # stores token in ~/.config/glab-cli/config.yml
# Both are needed before addzhost can auto-add a deploy key on your behalf.

