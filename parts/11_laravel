#!/bin/bash

. ${BASH_SOURCE%/*}/00_settings

logline "11.00 laravel START"

logline "11.01 create /var/www for laravel apps using Zero Downtime Deploy"

mkdir -p /var/www
chown $username:www-data /var/www
chmod -R 775 /var/www

myip=`curl -4 -s ifconfig.me`

#logline "11.02 create a simple (github/laravel/laravel) site on http://$myip using addzhost?"

# $dolaravelwebsite is normally pre-asked in parts/02_set_hostname so this part can run
# unattended. Fall back to prompting here when the script is executed standalone.
# Use ${var+set} so a deliberate empty answer (= default "yes") is NOT re-prompted.
if [ -z "${dolaravelwebsite+set}" ]; then
	echo -n "A default laravel webite is optional. Install default webite @ http://$myip [Y/n]=>" && read dolaravelwebsite
fi
if [ ! "$dolaravelwebsite" == "n" ]; then
	# make sure everything exists
	echo "Creating a laravel project for user $username"
	cd /var/www
	rm -Rf laravel

	su - $username <<-'UEOF'
	# use simple git clone for demo website
	cd /var/www
	composer create-project laravel/laravel laravel --no-interaction
	cd laravel
	chmod -R 775 /var/www/laravel/storage /var/www/laravel/bootstrap/cache
	composer install
UEOF
	# back at root
  	cd /var/www/laravel

	# $mysqlpwd is normally pre-asked in parts/02_set_hostname so this part can run
	# unattended. Fall back to prompting here when the script is executed standalone.
	# Use ${var+set} so a deliberately empty password is NOT re-prompted.
	if [ -z "${mysqlpwd+set}" ]; then
		# Loop until a non-empty password is given - we use it both to log
		# into mariadb and as the DB_PASSWORD in the generated .env, so an
		# empty value would silently break the laravel demo.
		mysqlpwd=""
		while [ -z "$mysqlpwd" ]; do
			echo -n "Enter your mysql (mariadb) root password (cannot be empty) =>" && read mysqlpwd
		done
	fi
	mysql -u root -p$mysqlpwd -e "CREATE DATABASE laravel;"

	# EOF quoted: expand bash vars
	cat <<-EOF >.env
		APP_NAME=Laravel
		APP_ENV=local
		APP_KEY=
		APP_URL=http://localhost

		LOG_CHANNEL=stack
		LOG_DEPRECATIONS_CHANNEL=null
		LOG_LEVEL=debug

		DB_CONNECTION=mysql
		DB_HOST=127.0.0.1
		DB_PORT=3306
		DB_DATABASE=laravel
		DB_USERNAME=root
		DB_PASSWORD=$mysqlpwd
EOF
	chown $username:www-data /var/www/laravel/.env
	su - $username <<-'UEOF'
	cd /var/www/laravel
	php artisan key:generate
	echo "Now run artisan Migrate"
	php artisan migrate
UEOF
	# back at root
    chmod -R a+w storage
	sudo cat << EOF-nginxconf >/etc/nginx/sites-available/01-laravel.conf
		server {
		listen   80;
		server_name _;
		root /var/www/laravel/public;
		index  index.html index.htm index.php;

		location / {
				try_files \$uri \$uri/ /index.php?\$query_string;
		}

		location ~ \.php\$ {
			include snippets/fastcgi-php.conf;
			fastcgi_pass unix:/run/php/php$PHPVER-fpm.sock;
			fastcgi_buffers 256 128k;
			fastcgi_connect_timeout 300s;
			fastcgi_send_timeout 300s;
			fastcgi_read_timeout 300s;
		}
	}
EOF-nginxconf
	ln -s /etc/nginx/sites-available/01-laravel.conf /etc/nginx/sites-enabled
	rm /etc/nginx/sites-enabled/default
	rm /etc/nginx/sites-available/default

	#wait for reboot
	service nginx restart
	
fi
# back to where we came from
cd $INSTALLPWD

echo "!!! Use addzhost to add projects (located in ~/bin of $username)"

logline "11.99 laravel END"

