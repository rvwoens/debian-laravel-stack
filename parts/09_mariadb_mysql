#!/bin/bash

. ${BASH_SOURCE%/*}/00_settings

logline "09.00 mariadb mysql START"
# $domysql is normally pre-asked in parts/02_set_hostname so this part can run
# unattended. Fall back to prompting here when the script is executed standalone.
# Use ${var+set} so a deliberate empty answer (= default "yes") is NOT re-prompted.
if [ -z "${domysql+set}" ]; then
	echo -n "MYSQL (MARIADB) is optional. Install mariadb [Y/n]=>" && read domysql
fi
if [ ! "$domysql" = "n" ]; then

  logline "09.01 apt mariadb"

  # DEBIAN_FRONTEND=noninteractive and NEEDRESTART_MODE=a are exported in
  # parts/00_settings; APT_CONF_OPTS adds --force-confdef/--force-confold so
  # any config-file conflict silently keeps the existing local copy (no Y/N
  # prompt).
  apt install -y "${APT_CONF_OPTS[@]}" mariadb-server mariadb-client

  logline "09.02 enable and start"
  systemctl enable mariadb
  systemctl start mariadb

  # made non-interactive: 
  # mariadb-secure-installation
  logline "09.03 make mysql secure (scripted equivalent of mariadb-secure-installation)"
  # mariadb-secure-installation is interactive only; we replicate its actions
  # via SQL so the whole step runs unattended. Fresh installs of mariadb use
  # unix_socket auth for root@localhost, so we can connect as root with no
  # password from this script (which runs as root).
  #
  # If $mysqlpwd was not collected (e.g. running this part standalone without
  # going through step 02), fall back to prompting now.
  if [ -z "${mysqlpwd+set}" ]; then
    # Loop until a non-empty password is given - we are about to set this as
    # the real mariadb root password, so an empty value is not acceptable.
    mysqlpwd=""
    while [ -z "$mysqlpwd" ]; do
      echo -n "Enter a new mysql (mariadb) root password (cannot be empty) =>" && read mysqlpwd
    done
  fi

  # Use a HEREDOC piped into mariadb. Note the SQL escaping of the underscore
  # in 'test\_%' so it is treated as a literal underscore in the LIKE pattern.
  mariadb -u root <<-SQL
	-- set / change the root password (keeps unix_socket plugin as fallback
	-- so root on the local box can still log in without a password)
	ALTER USER 'root'@'localhost' IDENTIFIED BY '$mysqlpwd';
	-- remove anonymous users
	DELETE FROM mysql.global_priv WHERE User='';
	-- disallow remote root login
	DELETE FROM mysql.global_priv WHERE User='root' AND Host NOT IN ('localhost','127.0.0.1','::1');
	-- drop the default test database and its grants
	DROP DATABASE IF EXISTS test;
	DELETE FROM mysql.db WHERE Db='test' OR Db='test\\_%';
	FLUSH PRIVILEGES;
	SQL

fi

logline "09.99 mariadb END"

