#!/bin/bash

. ${BASH_SOURCE%/*}/00_settings

logline "02.00 set hostname"
while [ -z "$hostname" ]; do
        echo -n "Enter a hostname >" && read hostname
done

## lets name the host
hostnamectl set-hostname $hostname
## on debian we need a special entry for that in hosts. Use 127.0.1.1 not conflicting with localhost
echo "127.0.1.1   $hostname" >> /etc/hosts

logline "02.01 create ed25519 keypair in $username/.ssh"
su $username <<-'EOF'
	# now that we know the hostname, we can create the right ed25519.pub
	ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -C "$username@$(hostname)"
EOF

# --------------------------------------------------------------------------
# Gather all "downstream" questions up front so the rest of the install
# runs unattended. setup_full sources each part with `.` so the variables
# set here stay alive across parts 04, 06, 08, 09, 11 and 12.
#
# Each consuming part has a `[ -z "$VAR" ]` guard so it can still be run
# standalone (bash ./parts/NN_xxx) and will prompt then.
#
# You can also pre-seed any of these from the environment to make the run
# fully hands-off, e.g.
#     rootpas=n timezone=Europe/Amsterdam docowsay=y donode=y doyarn=n dopnpm=y \
#     domysql=y doredis=y dolaravelwebsite=n ./setup_full
# --------------------------------------------------------------------------
logline "02.50 pre-asking optional install questions"

# flush keyboard buffer before prompting
while read -t 1 garbage; do sleep 0; done

# Root password policy (consumed by parts/04_root_password)
echo -n "Do you want a long secure root password (l) or no password at all (n) [N/l]=>" && read rootpas

# Timezone (consumed by parts/06_global_settings) - blank = UTC
echo -n "What timezone do you want (enter for UTC) =>" && read timezone

# Fortune + cowsay banner in the user's .bashrc (consumed by parts/06_global_settings)
echo -n "Install fortune+cowsay banner on login (just for fun) [Y/n]=>" && read docowsay

# Node/npm/pnpm/yarn (all consumed by parts/08_node_npm).
# Node itself is the gateway -- if user says n to node, the JS package
# managers cannot be installed anyway, so we don't bother asking.
echo -n "Node/nvm/npm is optional. Install  [Y/n]=>" && read donode
if [ ! "$donode" = "n" ]; then
	# yarn = classic Facebook/Meta JS package manager (npm-compatible).
	# Defaulting to N because npm itself ships with node and most modern
	# laravel/vite projects only need npm or pnpm.
	echo -n "  Also install yarn (alternative JS package manager) [y/N]=>" && read doyarn
	# pnpm = fast, disk-efficient npm alternative (laravel/breeze / vite friendly).
	# Defaulting to Y because that has been the long-standing behaviour of this stack.
	echo -n "  Also install pnpm (recommended, fast npm alternative) [Y/n]=>" && read dopnpm
fi

# MariaDB / MySQL (consumed by parts/09_mariadb_mysql)
echo -n "MYSQL (MARIADB) is optional. Install mariadb [Y/n]=>" && read domysql
# Ask for the mariadb root password whenever mariadb is going to be installed.
# Currently consumed by parts/11_laravel (creates the laravel demo DB) but is
# handy to have set for any later mysql work in the same session.
if [ ! "$domysql" = "n" ]; then
	# Loop until a non-empty password is given - mariadb-secure-installation
	# step (and the laravel demo DB create) both rely on a real password.
	mysqlpwd=""
	while [ -z "$mysqlpwd" ]; do
		echo -n "Enter your mysql (mariadb) root password (cannot be empty) =>" && read mysqlpwd
	done
fi

# Redis (consumed by parts/12_redis)
echo -n "redis installation is optional. Install Redis [Y/n]=>" && read doredis

# Default Laravel demo site (consumed by parts/11_laravel)
myip=`curl -4 -s ifconfig.me`
echo -n "A default laravel webite is optional. Install default webite @ http://$myip [Y/n]=>" && read dolaravelwebsite



logline "02.99 set hostname END"

