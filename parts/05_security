#!/bin/bash

. ${BASH_SOURCE%/*}/00_settings

logline "05.00 security"

logline "05.01 ssh security"

# All sshd hardening lives in a single drop-in file. On Debian 12+ the stock
# /etc/ssh/sshd_config starts with `Include /etc/ssh/sshd_config.d/*.conf`,
# and sshd uses FIRST-occurrence-wins, so any setting we put here will
# authoritatively beat whatever is later in the main config, in any other
# drop-in (e.g. cloud-init's 50-cloud-init.conf which re-enables
# PasswordAuthentication on cloud images), or in any package update of
# sshd_config itself.
#
# We use the 00- prefix so this file is read FIRST (alphabetical glob order)
# and therefore wins the first-wins race against any 50-cloud-init.conf etc.
mkdir -p /etc/ssh/sshd_config.d
cat <<-'EOF' >/etc/ssh/sshd_config.d/00-hardening.conf
	# managed by debian-laravel-stack/parts/05_security - do not edit by hand
	# Loaded before any other drop-in, so these values win.

	# --- authentication ---------------------------------------------------
	PasswordAuthentication no
	PubkeyAuthentication yes
	PermitRootLogin no
	PermitEmptyPasswords no
	HostbasedAuthentication no
	IgnoreRhosts yes
	StrictModes yes
	# allow older ssh clients to connect (e.g. dbeaver) by re-enabling ssh-rsa
	PubkeyAcceptedKeyTypes +ssh-rsa

	# --- networking / forwarding ------------------------------------------
	X11Forwarding no
	GatewayPorts no
	TCPKeepAlive yes

	# --- logging ----------------------------------------------------------
	SyslogFacility AUTH
	LogLevel INFO

	# --- ux ---------------------------------------------------------------
	PrintMotd no

	# --- deprecated / removed in modern OpenSSH (kept here as history) ----
	# Protocol 2                   # removed in OpenSSH 7.6 - only protocol 2 is supported
	# UsePrivilegeSeparation yes   # removed in OpenSSH 7.5 - privsep is always on
EOF
chmod 0644 /etc/ssh/sshd_config.d/00-hardening.conf

# Validate the merged config BEFORE restarting, otherwise we may lock ourselves out.
sshd -t

# and reboot the service
systemctl restart ssh.service

# Confirm what sshd is actually using at runtime (sshd -T prints the
# *effective* config after all Includes/drop-ins are merged). If any of
# these lines does not say what we expect, something is overriding us.
echo "---- effective sshd settings ----"
sshd -T | grep -iE '^(passwordauthentication|permitrootlogin|permitemptypasswords|pubkeyauthentication|x11forwarding|gatewayports)\b'
echo "---------------------------------"


logline "05.02 firewall"

# Set defaults
ufw default deny incoming
ufw default allow outgoing

# Allow SSH first (important!)
ufw allow 22/tcp

# Add port 80 and 443
ufw allow 80/tcp
ufw allow 443/tcp

# Enable the firewall
ufw enable

# Show overview
ufw status verbose

logline "05.03 fail2ban aggressive sshd protection"
apt install -y fail2ban
# - maxretry/findtime: 3 failed attempts within 10 minutes -> ban
# - bantime  1w       : keep them out for a week (was 1 day)
# - mode = aggressive : matches more patterns (probe-style scans, not just auth failures)
cat <<-'EOF' >/etc/fail2ban/jail.local
	[sshd]
	enabled = true
	maxretry = 3
	findtime = 10m
	bantime = 1w
	mode = aggressive
EOF
systemctl start fail2ban
systemctl enable fail2ban

# Check status
fail2ban-client status

# Check specific jail
fail2ban-client status sshd

# --------------------------------------------------------------------------
# 05.04 CrowdSec - DISABLED (May 2026)
# --------------------------------------------------------------------------
# Why disabled:
#   - Debian's own crowdsec package is stuck on v1.4.6 (Aug 2022), three
#     years behind upstream, and incompatible with the current Hub format,
#     so `apt install crowdsec` from main is effectively dead.
#   - The upstream packagecloud repo (via https://install.crowdsec.net)
#     keeps breaking on Debian 13 (Trixie): the security engine installs
#     fine, but `crowdsec-firewall-bouncer-nftables` cannot be located in
#     the repo. Without a bouncer, crowdsec only DETECTS attacks, nothing
#     blocks them - which makes the whole exercise pointless.
#   - There is an open upstream issue about Trixie packaging since Sep 2025
#     with no ETA. We're not the only ones hitting this.
#
# What we use instead:
#   - fail2ban (step 05.03 above) handles per-IP brute-force banning.
#   - sshd is password-auth disabled (step 05.01), so SSH brute force is
#     impossible regardless of fail2ban / crowdsec.
#   - ufw default-deny incoming (step 05.02) covers the perimeter.
#
# When to re-enable (paste the block back from git history):
#   1. Upstream confirms that crowdsec-firewall-bouncer-nftables is in the
#      packagecloud "any/any" repo for Debian 13 / 14
#      ( https://discourse.crowdsec.net thread "Debian Package crowdsec-
#      firewall-bouncer-nftables cannot be found" - currently OPEN )
#   2. Or CrowdSec ships their own apt repo (not packagecloud) - the
#      install.crowdsec.net wrapper-around-a-wrapper is fragile.
#   3. Verify with on a fresh Trixie box:
#         curl -s https://install.crowdsec.net | sudo bash
#         apt-cache show crowdsec-firewall-bouncer-nftables   # must succeed
#         apt install -y crowdsec crowdsec-firewall-bouncer-nftables
#
# The full previous implementation lives in git history if you want to
# restore it (look for "05.04 CrowdSec" before this commit).
# --------------------------------------------------------------------------

logline "05.99 security END"

