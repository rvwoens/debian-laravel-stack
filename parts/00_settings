#!/bin/bash

## common stuff
RED='\033[0;101m'
GREEN='\033[0;102m'
NC='\033[0m'

logline () {
	echo -e "${GREEN} >>>> $1           ${NC}"
}

## grep some info out of the os-release file
OS_ID=$(grep -oP '(?<=^ID=).+' /etc/os-release | tr -d '"')
OS_VERSION=$(grep -oP '(?<=^VERSION_ID=).+' /etc/os-release | tr -d '"')
# Use 8.0,8.1,8.2,8.3,8.4 etc
PHPVER=8.3

# Node major version used by parts/08_node_npm:
#   "lts"  -> hits NodeSource's magic https://deb.nodesource.com/setup_lts.x
#            which always resolves to the current Active LTS major
#            (in May 2026 that is 24 'Krypton'; in Oct 2026 it will become 26).
#   "22", "24", ... -> pin to a specific major when an app needs to match a
#            dev environment exactly.
# Track the schedule at https://github.com/nodejs/Release  (active LTS column).
NODEVER=lts
INSTALLPWD=`pwd`

# --------------------------------------------------------------------------
# Apt non-interactivity (exported so every sourced part + every subprocess
# inherits it):
#   DEBIAN_FRONTEND=noninteractive  -> debconf never shows TUI dialogs
#   NEEDRESTART_MODE=a              -> needrestart auto-restarts services
#                                      (Debian 12+); ignored on older systems
# APT_CONF_OPTS is a bash array that should be passed to every apt invocation
# that might trigger config-file conflicts (typically full-upgrade and
# upgrades of services with /etc/<pkg>.conf files). Usage:
#     apt install -y "${APT_CONF_OPTS[@]}" some-package
# --------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
APT_CONF_OPTS=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

# --------------------------------------------------------------------------
# Automatic reboot time for unattended-upgrades (parts/02 asks, parts/05 uses)
#   valid_reboottime <value> -> true for empty (= no automatic reboots) or a
#                               24h time HH:MM (00:00-23:59)
#   ask_reboottime <tz>      -> prompts until valid, sets $reboottime.
#                               <tz> is only shown in the prompt.
# --------------------------------------------------------------------------
valid_reboottime () {
	[ -z "$1" ] || [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]
}
ask_reboottime () {
	while true; do
		echo -n "  Reboot automatically when an update needs it? Enter time HH:MM ($1), or enter for never =>" && read reboottime
		valid_reboottime "$reboottime" && break
		echo "  !! \"$reboottime\" is not a valid time - use HH:MM between 00:00 and 23:59 (e.g. 04:00)"
	done
}

