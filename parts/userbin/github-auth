#!/bin/bash
# ----------------------------------------------------------------------
# github-auth [HOSTNAME]
# ----------------------------------------------------------------------
# Authenticate the `gh` CLI for HOSTNAME (default: github.com).
# GitHub Enterprise Server works too:    github-auth github.mycorp.com
#
# `gh` itself is installed by setup_full step 03.06 - this script does
# NOT install it (the stack assumes a fresh-server install path; see the
# install note at the top of README.md).
#
# Behaviour:
#   - If already authenticated for HOSTNAME -> print status, exit 0.
#   - Else run `gh auth login --hostname HOSTNAME --git-protocol ssh --web`
#     which uses the device-code flow (prints a short code + a generic URL
#     you open in any browser on any machine - no callback needed).
#
# Exit codes:
#   0 = authenticated for HOSTNAME
#   1 = failed (gh missing, login cancelled, etc.)
#
# Also called by addzhost when a deploy-key auto-add is needed for a
# github.com / GHE repository.
# ----------------------------------------------------------------------

set -u

GH_HOST="${1:-github.com}"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
fi

# ----------------------------------------------------------------------
# main
# ----------------------------------------------------------------------
if ! command -v gh >/dev/null 2>&1; then
	echo "!! gh (GitHub CLI) is not installed."
	echo "!! This stack is for fresh installs - gh should have been installed"
	echo "!! by setup_full step 03.06. To install manually now, re-run the block:"
	echo "!!     sudo bash parts/03_basic_packages       # or just the 03.06 stanza"
	exit 1
fi

# Already authenticated? Done.
if gh auth status --hostname "$GH_HOST" >/dev/null 2>&1; then
	echo ">>>> gh already authenticated for $GH_HOST"
	gh auth status --hostname "$GH_HOST" || true
	exit 0
fi

echo ""
echo ">>>> gh needs to authenticate for $GH_HOST"
echo "    Using device-code flow: gh will print a short code + a URL;"
echo "    open the URL on any device with a browser, paste the code, authorize."
echo ""
if gh auth login --hostname "$GH_HOST" --git-protocol ssh --web \
	&& gh auth status --hostname "$GH_HOST" >/dev/null 2>&1; then
	echo ">>>> gh is now authenticated for $GH_HOST."
	exit 0
fi

echo "!! gh auth login did not complete - aborted"
exit 1
