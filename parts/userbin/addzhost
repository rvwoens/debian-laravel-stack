#!/bin/bash

if [ -z "$2" ]; then
	echo "Usage: addzhost <domain> <pull-repo> [<initial-tag>]"
	echo "Add Zero Downtime Deployment virtual LARAVEL host using export from remote repository"
 	echo "1) creates /var/www/domain"
 	echo "2) creates vhost nginx to domain and *.domain (like www.asd.nl)"
 	echo "3) creates puller to pull from git repo <pull-repo>"
	echo "4) checks out <initial-tag> as first release or asks you"
	echo "USE FULL DOMAIN like xxyy.nl or asd.com"
	echo "Dont forget to edit the .env on the top directory!"
	exit;
fi
# expand the ~ directory
HOME=`readlink -f ~`

if [ -z $3 ]; then
	echo "initial tag (use main or master if there is no tag yet)"
	read TAG
else
	TAG=$3
fi

export WWWDIR=/var/www
export VHOSTDIR=/etc/nginx/sites-available

WWWSITE=$WWWDIR/$1
GITREPO=$2
SERVERNAME=$1

if [ -d $WWWSITE ]; then
	echo "$WWWSITE already exists!"
	echo "Remove !!! WILL REMOVE THE WHOLE DIR !!! (N/y)"
	read removedir
	if [ "$removedir" == "y" ]; then
		rm -Rf $WWWSITE
	else
		exit
	fi
fi

if [[ "$GITREPO" =~ ^https://github.com ]]; then
  GITHUB_SIMPLE_REPO=Y
  echo "! Using SIMPLE github repo with clone"
else
  GITHUB_SIMPLE_REPO=N
fi

# ----------------------------------------------------------------------
# Test that we can actually reach $GITREPO BEFORE we create any directory
# or generate any script. The most common addzhost failure is that this
# server's public key has not yet been added as a deploy key on the git
# remote -- testing here means we can show that pubkey and let the user
# add it before we touch anything.
#
# `git ls-remote --exit-code <url> HEAD` is read-only, works for both
# ssh:// (git@...) and https:// remotes, and returns non-zero on any
# access failure. We force `BatchMode=yes` on the ssh side so it fails
# immediately instead of hanging on a passphrase / password prompt, and
# `StrictHostKeyChecking=accept-new` so we trust github/gitlab on first
# contact (with a warning if the key changes later).
# ----------------------------------------------------------------------
# Pick the pubkey we will offer / upload (prefer ed25519 over rsa).
if [ -f ~/.ssh/id_ed25519.pub ]; then
	MYPUBKEY=~/.ssh/id_ed25519.pub
elif [ -f ~/.ssh/id_rsa.pub ]; then
	MYPUBKEY=~/.ssh/id_rsa.pub
else
	MYPUBKEY=""
fi

# ----------------------------------------------------------------------
# detect_provider <git-url>
#   Sets PROVIDER (github|gitlab|other) and OWNERREPO (owner/repo) from
#   either an ssh url (git@host:owner/repo.git) or an https url
#   (https://host/owner/repo[.git]).
# ----------------------------------------------------------------------
detect_provider() {
	local url="$1"
	PROVIDER=other
	OWNERREPO=""
	# strip optional trailing .git
	local stripped="${url%.git}"
	if [[ "$stripped" =~ ^git@([^:]+):(.+)$ ]]; then
		local host="${BASH_REMATCH[1]}"
		OWNERREPO="${BASH_REMATCH[2]}"
		case "$host" in
			github.com)  PROVIDER=github ;;
			gitlab.com)  PROVIDER=gitlab ;;
			gitlab*)     PROVIDER=gitlab ;; # self-hosted gitlab.example.com etc.
			github*)     PROVIDER=github ;;
		esac
	elif [[ "$stripped" =~ ^https?://([^/]+)/(.+)$ ]]; then
		local host="${BASH_REMATCH[1]}"
		OWNERREPO="${BASH_REMATCH[2]}"
		case "$host" in
			github.com)  PROVIDER=github ;;
			gitlab.com)  PROVIDER=gitlab ;;
			gitlab*)     PROVIDER=gitlab ;;
			github*)     PROVIDER=github ;;
		esac
	fi
}

# ----------------------------------------------------------------------
# try_autoadd_deploykey
#   Detects gh / glab; if installed AND authenticated for the right
#   provider, offers to add $MYPUBKEY as a deploy key on the remote repo.
#   Returns 0 on success (key added), non-zero otherwise (so caller can
#   fall back to the manual paste flow).
# ----------------------------------------------------------------------
try_autoadd_deploykey() {
	[ -n "$MYPUBKEY" ] || return 1
	detect_provider "$GITREPO"
	[ -n "$OWNERREPO" ] || return 1
	local title="$(hostname)-$(basename "$WWWSITE")"

	case "$PROVIDER" in
		github)
			command -v gh >/dev/null 2>&1 || return 1
			# `gh auth status` returns 0 only when authenticated for github.com.
			# If not authenticated, offer to run the interactive login flow.
			# `gh auth login --web` prints a one-time code + URL the user opens
			# in any browser (works fine over SSH; the server itself does not
			# need a browser). --git-protocol ssh matches our ssh git remote.
			if ! gh auth status >/dev/null 2>&1; then
				echo "!! gh CLI is installed but not authenticated for github.com."
				echo -n "Run 'gh auth login' now to authenticate? [Y/n] >" && read yn
				if [ "$yn" = "n" ] || [ "$yn" = "N" ]; then return 1; fi
				gh auth login --hostname github.com --git-protocol ssh --web || true
				# Re-check; if the login was cancelled, fall back to manual.
				if ! gh auth status >/dev/null 2>&1; then
					echo "!! still not authenticated - falling back to manual paste flow"
					return 1
				fi
				echo ">>>> gh is now authenticated."
			fi
			echo -n "Auto-add this server's pubkey as a read-only Deploy Key on github.com/$OWNERREPO ? [Y/n] >" && read yn
			if [ "$yn" = "n" ] || [ "$yn" = "N" ]; then return 1; fi
			# gh repo deploy-key add <key-file> --title <t> -R owner/repo
			# (no --allow-write flag means read-only, which is what we want)
			if gh repo deploy-key add "$MYPUBKEY" --title "$title" -R "$OWNERREPO"; then
				echo ">>>> Deploy key uploaded to github.com/$OWNERREPO"
				return 0
			fi
			echo "!! gh failed to add the deploy key (already exists?)"
			return 1
			;;
		gitlab)
			command -v glab >/dev/null 2>&1 || return 1
			# Same pattern as gh above: if installed but not authenticated for
			# the matching host, offer to run the interactive login. We pass
			# --hostname explicitly so self-hosted GitLab works too.
			# glab auth login is interactive (browser / token); over SSH the
			# browser flow shows a one-time code the user opens in any browser.
			local glab_host=gitlab.com
			# Re-detect the hostname for self-hosted gitlabs from $GITREPO.
			if [[ "$GITREPO" =~ ^git@([^:]+): ]]; then
				glab_host="${BASH_REMATCH[1]}"
			elif [[ "$GITREPO" =~ ^https?://([^/]+)/ ]]; then
				glab_host="${BASH_REMATCH[1]}"
			fi
			if ! glab auth status --hostname "$glab_host" >/dev/null 2>&1; then
				echo "!! glab CLI is installed but not authenticated for $glab_host."
				echo -n "Run 'glab auth login --hostname $glab_host' now to authenticate? [Y/n] >" && read yn
				if [ "$yn" = "n" ] || [ "$yn" = "N" ]; then return 1; fi
				glab auth login --hostname "$glab_host" || true
				if ! glab auth status --hostname "$glab_host" >/dev/null 2>&1; then
					echo "!! still not authenticated - falling back to manual paste flow"
					return 1
				fi
				echo ">>>> glab is now authenticated for $glab_host."
			fi
			echo -n "Auto-add this server's pubkey as a read-only Deploy Key on $OWNERREPO ? [Y/n] >" && read yn
			if [ "$yn" = "n" ] || [ "$yn" = "N" ]; then return 1; fi
			# glab deploy-key add <key-file> --title <t> -R group/repo
			# (no --can-push flag means read-only)
			if glab deploy-key add "$MYPUBKEY" --title "$title" -R "$OWNERREPO"; then
				echo ">>>> Deploy key uploaded to $OWNERREPO"
				return 0
			fi
			echo "!! glab failed to add the deploy key (already exists?)"
			return 1
			;;
		*)
			return 1
			;;
	esac
}

echo ">>>> Testing git repository access: $GITREPO"
while true; do
	if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new" \
		git ls-remote --exit-code "$GITREPO" HEAD >/dev/null 2>&1; then
		echo ">>>> repo access OK"
		break
	fi
	echo ""
	echo "!! Could not reach $GITREPO"

	# Best path first: if gh/glab is installed AND authenticated, offer to
	# add the deploy key in one step. On success we loop back and retest.
	if try_autoadd_deploykey; then
		echo ">>>> retrying repo access..."
		continue
	fi

	echo "!! Manual fallback: add the following public key as a Deploy Key on the repo:"
	echo "!!   GitLab : Project -> Settings -> Repository -> Deploy keys -> Add deploy key"
	echo "!!   GitHub : Repo    -> Settings -> Deploy keys             -> Add deploy key"
	echo "!! (read-only is enough for pulling; tick 'write' only if puller needs to push)"
	echo "!! Tip: authenticate gh/glab once to let addzhost auto-add this next time:"
	echo "!!   gh   auth login                                (for github.com)"
	echo "!!   glab auth login --hostname gitlab.com          (for gitlab.com / self-hosted: use your host)"
	echo ""
	if [ -n "$MYPUBKEY" ]; then
		echo "------ $MYPUBKEY ------------------------------------"
		cat "$MYPUBKEY"
		echo "-----------------------------------------------------------------"
	else
		echo "!! No public key found in ~/.ssh/ - generate one first with:"
		echo "!!   ssh-keygen -t ed25519 -C \"$USER@$(hostname)\""
	fi
	echo ""
	echo -n "R) Retry  S) Stop  C) Continue anyway [R/s/c] >" && read retry
	case "$retry" in
		s|S) echo "Stopped."; exit 1 ;;
		c|C) echo "Continuing despite git access failure - puller will likely fail later"; break ;;
		*) ;; # anything else (incl. just Enter) = retry
	esac
done

echo "Laravel app    at: $WWWSITE"
echo "Git repository at: $GITREPO"

echo "Servername       : $SERVERNAME"
echo "Initial release  : $TAG"
echo -n "Press return to continue >" && read

echo ">>>> Generating laravel directory structure for Zero-Downtime-Deploy"
sudo mkdir $WWWSITE
sudo mkdir -p $WWWSITE/releases/$TAG
sudo mkdir -p $WWWSITE/storage
sudo chown -R $USER:www-data $WWWSITE
mkdir -p $WWWSITE/storage/logs
mkdir -p $WWWSITE/storage/framework/cache
mkdir -p $WWWSITE/storage/framework/views
mkdir -p $WWWSITE/storage/framework/sessions
chmod a+w -R $WWWSITE/storage
echo "STUB" >$WWWSITE/storage/stub

echo "Directory structure made. Do you want to edit the .env file? (N/y)"
read editenv
if [ "$editenv" == "y" ]; then
	nano $WWWSITE/.env
else
	cat <<-EOFETC >$WWWSITE/.env
		APP_ENV=prod
		APP_KEY=base64:/kWEgZL5G/I7zQi72qocObBxeHNMDJfJEwIHy+tdeAk=
	EOFETC
fi

cd $WWWSITE
# create puller script. Heredoc without quotes will interpolate $ and literal $ needs \$ and <<- heredoc will allow indentation
cat << EOFPULLER >$WWWSITE/puller
	if [ -z "\$1" ]; then
		echo "Usage: puller <tag>"
		exit
	fi
	# exit on any failure
	set -e
	export PROJECT_DIR=$WWWSITE
	RELEASE_DIR=\$PROJECT_DIR/releases/\$1
	STORAGE_DIR=\$PROJECT_DIR/storage
	ENV_DIR=\$PROJECT_DIR/.env
	CURRENT_DIR=\$PROJECT_DIR/current

	mkdir -p \$RELEASE_DIR
	cd \$RELEASE_DIR
	echo ">>>> Pulling git archive from $GITREPO into \$RELEASE_DIR"
	if [ "$GITHUB_SIMPLE_REPO" == "Y" ]; then
	  if [ -z "\$1" ]; then
	    git clone $GITREPO .
	  else
	    git clone --branch \$1 $GITREPO .
	  fi
	else
	  git archive --remote=$GITREPO --format=tar \$1 | tar xf -
  fi
	echo ">>>> Pulled \$1 archive. Now do some after-deploy work"
	sudo chown $USER:www-data -R \$RELEASE_DIR
	# standard symlinks
	ln -sf \$ENV_DIR ./
	rm -Rf storage
	ln -sf \$STORAGE_DIR ./
	composer install -o --no-interaction --no-dev
	if [ -f after_deploy ]; then
		. ./after_deploy
	fi
	sudo chmod a+w -R \$STORAGE_DIR
	# this one might not exist
	sudo chmod -f a+w \$RELEASE_DIR/bootstrap/cache || true
	# now swap for current
	echo ">>>> \$1 ready to go live"
	rm -f \$CURRENT_DIR
	# even more atomic: ln -sf \$RELEASE_DIR current_tmp && mv -Tf current_tmp current
	ln -sf \$RELEASE_DIR \$CURRENT_DIR
	echo ">>>> \$1 is now live"
	#maybe we need to restart some services like queue workers that need everything in 'current'
	if [ -f after_deploy_is_live ]; then
		. ./after_deploy_is_live
	fi
	exit 0
EOFPULLER
cat << EOFROLLBACK >$WWWSITE/rollback
	if [ -z "\$1" ]; then
                echo "Usage: rollback <tag> - rolls back to <tag> which should already exist"
                exit
        fi
	set -e

	export PROJECT_DIR=$WWWSITE
	RELEASE_DIR=\$PROJECT_DIR/releases/\$1
	STORAGE_DIR=\$PROJECT_DIR/storage
	ENV_DIR=\$PROJECT_DIR/.env
	CURRENT_DIR=\$PROJECT_DIR/current

	if [ ! -d \$RELEASE_DIR ]; then
		echo "Release $1 does not exist"
		exit
	fi
	echo "\$1 ready to go live"
        rm -f $WWWSITE/current
        ln -sf \$RELEASE_DIR $WWWSITE/current
        echo "\$1 is now live"
EOFROLLBACK
chmod a+x $WWWSITE/puller
chmod a+x $WWWSITE/rollback
echo "Created $WWWSITE ZDD structure. Now pulling initial release"
if $WWWSITE/puller $TAG ; then
	echo "Successful pull. Lets continue"
else
	echo "The pull was not succesfull. Options: "
	echo "R) Rollback - remove directory $WWWSITE and exit - so you can try again"
	echo "S) Stop - just exit."
	echo "C) Continue - create NGINX site info"
	read rollback
	case "$rollback" in
		R)
			echo "Rollback"
			echo "Removing $WWWSITE "
			sudo rm -Rf $WWWSITE
			echo "Rolled back"
			exit 1
			;;
		S|*)
			echo "Stop"
			exit 1
			;;
		C)
			echo "Continue"
			;;
	esac
fi
echo "------------------------- NGINX vhost ---------------------------"
max=0
for f in $VHOSTDIR/*.conf; do
        #echo $f
        v=`basename $f | grep -o "[0-9]*" | head -1`
        #echo "$f -> $v"
        if [ "$f" == "$VHOSTDIR/$v-$SERVERNAME.conf" ]; then
            echo "vhost already exists: $f - press enter to continue and move old to $f.org"
            read
            sudo mv $f $f.org
			sudo rm /etc/nginx/sites-enabled/$v-$SERVERNAME.conf
        fi
        if [ 0$v -gt 0$max ]; then
                max=$v
        fi
done
# convert max to 10based decimal (remove leading 0 which leads to octal numbers)
let "max=$((10#$max))+1"
printf -v maxf "%02d" $max
newconffile=$maxf-$SERVERNAME.conf
newconf=$VHOSTDIR/$maxf-$SERVERNAME.conf
PHPVER=`php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;'`
echo "Current PHP version: $PHPVER"
cat << EOF-nginxconf >/tmp/newconf
server {
        server_name www.$SERVERNAME;
        return 301 \$scheme://$SERVERNAME\$request_uri;
}
server {
   listen   80;
   server_name $SERVERNAME *.$SERVERNAME;
   root $WWWSITE/current/public;
   index  index.html index.htm index.php;

   location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
   }

   location ~ \.php\$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php$PHPVER-fpm.sock;
		fastcgi_buffers 256 128k;
		fastcgi_connect_timeout 300s;
		fastcgi_send_timeout 300s;
		fastcgi_read_timeout 300s;
    }
}
EOF-nginxconf
sudo cp /tmp/newconf $newconf
sudo ln -s $newconf /etc/nginx/sites-enabled/$newconffile
echo "Created $newconf for nginx. restarting nginx.."
sudo service nginx restart

# ----------------------------------------------------------------------
# Let's Encrypt / certbot
# ----------------------------------------------------------------------
# certbot needs the HTTP vhost to be live and reachable on port 80 from
# the public internet for the HTTP-01 challenge - that is why we run this
# AFTER `service nginx restart` above.
#
# We only request a cert for the apex ($SERVERNAME) and www.$SERVERNAME.
# The vhost server_name still contains *.$SERVERNAME so nginx will keep
# accepting wildcard subdomain traffic, but those subdomains will not be
# covered by this certificate (HTTP-01 cannot issue wildcards - that
# would need a DNS-01 challenge with a DNS provider plugin).
#
# certbot --nginx will:
#   1. add `listen 443 ssl;` + ssl_certificate* lines to the matching
#      server blocks (both the www redirect block and the main block)
#   2. with --redirect, rewrite the HTTP server to 301 to HTTPS
# ----------------------------------------------------------------------
echo "------------------------- Lets Encrypt (certbot) ---------------------------"
echo "Do you want to request a Lets Encrypt certificate for $SERVERNAME and www.$SERVERNAME now? (Y/n)"
read dossl
if [ "$dossl" != "n" ] && [ "$dossl" != "N" ]; then
	# Allow a default email via the CERTBOT_EMAIL env var (handy for
	# scripted reruns) but always let the user override interactively.
	if [ -n "$CERTBOT_EMAIL" ]; then
		echo "Email for Lets Encrypt registration [$CERTBOT_EMAIL]:"
	else
		echo "Email for Lets Encrypt registration (used for renewal/expiry notices):"
	fi
	read certemail
	if [ -z "$certemail" ]; then
		certemail="$CERTBOT_EMAIL"
	fi
	if [ -z "$certemail" ]; then
		echo "!! No email supplied - skipping certbot. You can re-run later with:"
		echo "   sudo certbot --nginx -d $SERVERNAME -d www.$SERVERNAME"
	else
		# --non-interactive + --agree-tos so we never block on a prompt
		# --redirect makes certbot turn the :80 vhost into a 301 to :443
		# -d order matters: first -d becomes the cert's CN
		sudo certbot --nginx \
			-d $SERVERNAME -d www.$SERVERNAME \
			--non-interactive --agree-tos --redirect \
			--email "$certemail"
		if [ $? -eq 0 ]; then
			echo "certbot success - reloading nginx"
			sudo service nginx reload
		else
			echo "!! certbot failed - the HTTP vhost is still live, you can retry with:"
			echo "   sudo certbot --nginx -d $SERVERNAME -d www.$SERVERNAME --email $certemail --agree-tos"
		fi
	fi
else
	echo "Skipping certbot. You can run it later with:"
	echo "   sudo certbot --nginx -d $SERVERNAME -d www.$SERVERNAME"
fi

echo "Adding Laravel schedule to crontab"
cd ~/crontab
echo "* * * * * php $WWWSITE/current/artisan schedule:run >> /dev/null 2>&1" >>crondef
crontab crondef
cd $INSTALLPWD

myip=`curl -s ifconfig.me`
echo "-------------------------------------------------------------"
