#!/bin/bash
# ----------------------------------------------------------------------
# gitlab-auth [HOSTNAME]
# ----------------------------------------------------------------------
# Authenticate the `glab` CLI for HOSTNAME (default: gitlab.com).
# Self-hosted GitLab works too:    gitlab-auth git.example.com
#
# `glab` itself is installed by setup_full step 03.07 - this script does
# NOT install it (the stack assumes a fresh-server install path; see the
# install note at the top of README.md).
#
# Behaviour:
#   - If already authenticated for HOSTNAME -> print status, exit 0.
#   - Else try OAuth device flow (clean UX, needs glab >= 1.55 and a
#     GitLab server >= 17.9; gitlab.com always qualifies).
#   - Else fall back to Personal Access Token paste (read -s, fed via
#     stdin so the token never appears on the command line / `ps`).
#
# Exit codes:
#   0 = authenticated for HOSTNAME
#   1 = failed (glab missing, login cancelled, no token, etc.)
#
# Also called by addzhost when a deploy-key auto-add is needed for a
# gitlab.com / self-hosted GitLab repository.
# ----------------------------------------------------------------------

set -u

GLAB_HOST="${1:-gitlab.com}"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
fi

# ----------------------------------------------------------------------
# main
# ----------------------------------------------------------------------
if ! command -v glab >/dev/null 2>&1; then
	echo "!! glab (GitLab CLI) is not installed."
	echo "!! This stack is for fresh installs - glab should have been installed"
	echo "!! by setup_full step 03.07. To install manually now, re-run the block:"
	echo "!!     sudo bash parts/03_basic_packages       # or just the 03.07 stanza"
	exit 1
fi

# Already authenticated? Done.
if glab auth status --hostname "$GLAB_HOST" >/dev/null 2>&1; then
	echo ">>>> glab already authenticated for $GLAB_HOST"
	glab auth status --hostname "$GLAB_HOST" || true
	exit 0
fi

echo ""
echo ">>>> glab needs to authenticate for $GLAB_HOST"

# Option 1: OAuth device-code flow (cleanest UX). Prints a short code +
# URL, polls until you authorize in any browser on any machine. No token
# to copy/paste, no localhost callback. Requires glab >= 1.55 AND a
# GitLab server >= 17.9 (gitlab.com always qualifies).
echo ""
echo "    Trying OAuth device-code flow (works on gitlab.com and self-hosted GitLab >= 17.9)..."
if glab auth login --hostname "$GLAB_HOST" --git-protocol ssh --device \
	&& glab auth status --hostname "$GLAB_HOST" >/dev/null 2>&1; then
	echo ">>>> glab is now authenticated for $GLAB_HOST (device flow)."
	exit 0
fi

# Option 2: Personal Access Token paste fallback. Works against every
# glab version and every GitLab server.
echo ""
echo "!! device flow not available or not completed - falling back to token paste."
echo ""
echo "    1) Open this URL in ANY browser (on any machine) to create a PAT:"
echo "         https://$GLAB_HOST/-/user_settings/personal_access_tokens"
echo "    2) Required scopes:   api   +   write_repository"
echo "       (glab needs both even if you only intend to read.)"
echo "    3) Name it something like 'gitlab-auth-$(hostname)' and copy the token."
echo ""
echo -n "Paste the token here (input hidden, then press Enter): "
read -s _pat
echo ""
if [ -z "$_pat" ]; then
	echo "!! no token entered - aborted"
	exit 1
fi
# Pipe via stdin so the token is never on the command line / never in `ps`.
if ! printf '%s' "$_pat" \
	| glab auth login --hostname "$GLAB_HOST" --git-protocol ssh --stdin; then
	echo "!! glab auth login --stdin failed"
	unset _pat
	exit 1
fi
unset _pat
if ! glab auth status --hostname "$GLAB_HOST" >/dev/null 2>&1; then
	echo "!! glab still reports not-authenticated"
	exit 1
fi
echo ">>>> glab is now authenticated for $GLAB_HOST (token)."
exit 0
